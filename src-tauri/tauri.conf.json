{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sweep",
  "version": "0.1.0",
  "identifier": "com.minhchien.sweep",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sweep",
        "width": 920,
        "height": 660,
        "minWidth": 720,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 24 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
